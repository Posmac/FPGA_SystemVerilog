LOCATE COMP "clk" SITE "P3";
IOBUF PORT "clk" IO_TYPE=LVCMOS33 PULLMODE=UP;

#LOCATE COMP "sim_clk" SITE "P3";
#IOBUF PORT "sim_clk" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "rst_n" SITE "E1";
IOBUF PORT "rst_n" IO_TYPE=LVCMOS33 PULLMODE=UP;

#slow daplink receiver
LOCATE COMP "rx" SITE "H18";
IOBUF PORT "rx" IO_TYPE=LVCMOS33;

#fast uart transmitter
LOCATE COMP "tx" SITE "K18";
IOBUF PORT "tx" IO_TYPE=LVCMOS33;